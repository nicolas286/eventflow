{
  "name": "saas-asbl-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run && node --test tests/deployment/*.checks.mjs",
    "check:target": "node scripts/deployment/check-target.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:backend": "deno task --config supabase/functions/deno.json check:edge",
    "lint:backend": "deno task --config supabase/functions/deno.json lint:edge",
    "test:backend": "deno task --config supabase/functions/deno.json test:edge"
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.0.1",
    "@supabase/supabase-js": "^2.91.1",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "nodemailer": "^8.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "vitest": "^4.1.9",
    "xlsx": "^0.18.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "knip": "^5.86.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
