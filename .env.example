# Public frontend values only. Never put a service_role key in a VITE_ variable.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_PUBLIC_BASE_URL=http://127.0.0.1:5173
# Cloudflare official test sitekey, never use for production.
VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA

# Stripe Connect configuration for event ticket payments only.
# Platform subscriptions are invoiced internally by Eventflow.
# Use "disabled" as an emergency kill switch.
EVENT_PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me
