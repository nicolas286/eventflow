VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_PUBLIC_BASE_URL=http://127.0.0.1:5173
# Cloudflare official test sitekey, never use for production.
VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA
